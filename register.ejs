<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>ALEX SCRAPER | REGISTRO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0c0e0e; color: #00f0ff; font-family: 'Geist Mono', monospace; }
        .cyber-border { border: 1px solid rgba(0, 240, 255, 0.3); background: #111313; }
        input { background: #0c0e0e; border: 1px solid rgba(0,240,255,0.3); color: #fff; }
        input:focus { outline: none; border-color: #00f0ff; }
    </style>
</head>
<body class="p-4 md:p-10 flex items-center justify-center min-h-screen">
    <div class="max-w-sm w-full cyber-border p-8 rounded-lg">
        <h1 class="text-2xl font-black italic mb-1">ALEX_SCRAPER_API</h1>
        <p class="text-[10px] opacity-40 uppercase tracking-widest mb-6">Crear cuenta</p>

        <% if (error) { %>
            <p class="text-red-500 text-xs mb-4"><%= error %></p>
        <% } %>

        <form method="POST" action="/register" class="space-y-4">
            <div>
                <label class="text-[10px] opacity-50 uppercase">Correo</label>
                <input type="email" name="email" required class="w-full p-2 rounded text-sm mt-1">
            </div>
            <div>
                <label class="text-[10px] opacity-50 uppercase">Contraseña (mínimo 6 caracteres)</label>
                <input type="password" name="password" required minlength="6" class="w-full p-2 rounded text-sm mt-1">
            </div>
            <button type="submit" class="w-full bg-[#00f0ff]/10 border border-[#00f0ff]/50 text-[#00f0ff] py-2 rounded text-sm font-bold uppercase tracking-widest hover:bg-[#00f0ff]/20 transition-all">
                Crear cuenta
            </button>
        </form>

        <p class="text-[11px] opacity-40 mt-6 text-center">
            ¿Ya tienes cuenta? <a href="/login" class="text-[#00f0ff] underline">Inicia sesión</a>
        </p>
    </div>
</body>
</html>
