<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX SCRAPER | REGISTRO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0c0e0e; color: #00f0ff; font-family: 'Geist Mono', monospace; }
        .cyber-border { border: 1px solid rgba(0, 240, 255, 0.3); background: #111313; }
        input { background: #0c0e0e; border: 1px solid rgba(0,240,255,0.3); color: #fff; }
        input:focus { outline: none; border-color: #00f0ff; }
    </style>
</head>
<body class="p-4 flex items-center justify-center min-h-screen">
    <div class="max-w-sm w-full cyber-border p-6 sm:p-8 rounded-lg">
        <h1 class="text-2xl sm:text-3xl font-black italic mb-1">ALEX_SCRAPER_API</h1>
        <p class="text-xs opacity-40 uppercase tracking-widest mb-6">Crear cuenta</p>

        <% if (error) { %>
            <p class="text-red-500 text-sm mb-4"><%= error %></p>
        <% } %>

        <div class="space-y-3 mb-5">
            <a href="/auth/google" class="w-full flex items-center justify-center gap-2 bg-white text-black py-3 rounded text-sm font-bold hover:bg-white/90 transition-all">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.5 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.2-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.9 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.5 5.5 29.5 3 24 3 16.3 3 9.6 7.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 45c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.3 36 26.8 37 24 37c-5.3 0-9.6-3.4-11.3-8l-6.6 5.1C9.5 40.6 16.2 45 24 45z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.3 5.3C39.9 37 44 31.4 44 24c0-1.2-.1-2.4-.4-3.5z"/></svg>
                Continuar con Google
            </a>
            <a href="/auth/github" class="w-full flex items-center justify-center gap-2 bg-[#181717] border border-white/20 text-white py-3 rounded text-sm font-bold hover:bg-[#181717]/80 transition-all">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.18 0 1.58-.01 2.85-.01 3.24 0 .3.2.66.79.55A10.51 10.51 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/></svg>
                Continuar con GitHub
            </a>
        </div>

        <div class="flex items-center gap-3 mb-5">
            <div class="flex-1 h-px bg-white/10"></div>
            <span class="text-[10px] opacity-30 uppercase">o con correo</span>
            <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <form method="POST" action="/register" class="space-y-4">
            <div>
                <label class="text-xs opacity-50 uppercase">Correo</label>
                <input type="email" name="email" required class="w-full p-3 rounded text-base mt-1">
            </div>
            <div>
                <label class="text-xs opacity-50 uppercase">Contraseña (mínimo 6 caracteres)</label>
                <input type="password" name="password" required minlength="6" class="w-full p-3 rounded text-base mt-1">
            </div>
            <button type="submit" class="w-full bg-[#00f0ff]/10 border border-[#00f0ff]/50 text-[#00f0ff] py-3 rounded text-sm font-bold uppercase tracking-widest hover:bg-[#00f0ff]/20 transition-all">
                Crear cuenta
            </button>
        </form>

        <p class="text-xs opacity-40 mt-6 text-center">
            ¿Ya tienes cuenta? <a href="/login" class="text-[#00f0ff] underline">Inicia sesión</a>
        </p>
    </div>
</body>
</html>
