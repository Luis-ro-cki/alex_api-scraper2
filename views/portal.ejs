<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>ALEX SCRAPER | CONTROL PANEL</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0d0f0f; color: #00f0ff; font-family: 'monospace'; }
        .neon-glow { box-shadow: 0 0 20px rgba(0, 240, 255, 0.2); border: 1px solid #00f0ff44; }
        .bg-cyber { background: linear-gradient(145deg, #121414, #0a0b0b); }
    </style>
</head>
<body class="p-4 md:p-12">
    <div class="max-w-6xl mx-auto">
        <header class="flex justify-between items-center mb-12 border-b border-[#00f0ff]/30 pb-6">
            <div>
                <h1 class="text-4xl font-black tracking-tighter italic text-[#00f0ff] drop-shadow-md">ALEX_SCRAPER_API</h1>
                <p class="text-[10px] text-white/50 uppercase mt-1">Multi-Platform Data Extraction Engine</p>
            </div>
            <div class="text-right">
                <div class="text-xs font-bold text-green-400">SERVER STATUS: ACTIVE</div>
                <div class="text-[10px] opacity-40">RENDER_CLOUD_NODE_01</div>
            </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
            <div class="bg-cyber neon-glow p-6 rounded">
                <p class="text-[10px] opacity-50">TIKTOK SCRAPER</p>
                <p class="text-xl font-bold">READY</p>
            </div>
            <div class="bg-cyber neon-glow p-6 rounded">
                <p class="text-[10px] opacity-50">SPOTIFY ENGINE</p>
                <p class="text-xl font-bold">READY</p>
            </div>
            <div class="bg-cyber neon-glow p-6 rounded">
                <p class="text-[10px] opacity-50">SOCIAL FB/TW</p>
                <p class="text-xl font-bold">READY</p>
            </div>
            <div class="bg-cyber neon-glow p-6 rounded text-yellow-400">
                <p class="text-[10px] opacity-50">GMAPS API</p>
                <p class="text-xl font-bold">ACTIVE</p>
            </div>
        </div>

        <div class="bg-cyber neon-glow rounded-lg overflow-hidden">
            <div class="p-6 border-b border-[#00f0ff]/20">
                <h2 class="text-sm font-bold">ACTIVE API KEYS</h2>
            </div>
            <table class="w-full text-left text-xs">
                <thead class="bg-black/50 opacity-50">
                    <tr>
                        <th class="p-4">IDENTIFIER</th>
                        <th>PLAN</th>
                        <th>REQUESTS</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    <% Object.keys(keys).forEach(k => { %>
                    <tr class="border-b border-white/5 hover:bg-[#00f0ff]/5 transition-all">
                        <td class="p-4 font-mono text-white"><%= k %></td>
                        <td><span class="bg-[#00f0ff]/10 px-2 py-1 rounded text-[#00f0ff]"><%= keys[k].plan %></span></td>
                        <td><%= keys[k].used %></td>
                        <td class="text-green-500 font-bold italic">LIVE</td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>