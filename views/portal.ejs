<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX SCRAPER | PORTAL</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0c0e0e; color: #00f0ff; font-family: 'Geist Mono', monospace; }
        .cyber-border { border: 1px solid rgba(0, 240, 255, 0.3); background: #111313; box-shadow: 0 0 15px rgba(0, 240, 255, 0.05); }
        .neon-text { text-shadow: 0 0 10px #00f0ff; }
        .status-pulse { animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }
    </style>
</head>
<body class="p-4 sm:p-6 md:p-10">
    <div class="max-w-6xl mx-auto">
        <header class="flex flex-col sm:flex-row justify-between sm:items-end gap-4 border-b border-[#00f0ff]/40 pb-6 mb-8">
            <div>
                <h1 class="text-3xl sm:text-4xl font-black italic neon-text">ALEX_SCRAPER_API</h1>
                <p class="text-xs text-white/40 tracking-[0.2em] uppercase mt-2">Data Intelligence & Extraction System</p>
            </div>
            <div class="sm:text-right">
                <p class="text-xs text-green-400 font-bold status-pulse tracking-widest">● SYSTEM_ONLINE</p>
                <p class="text-[11px] opacity-30 mb-2">HOST: RENDER_CLOUD_NODE_X</p>
                <div class="flex gap-2 sm:justify-end">
                    <a href="/endpoints" class="text-xs uppercase tracking-widest border border-[#00f0ff]/40 px-3 py-2 rounded hover:bg-[#00f0ff]/10">Endpoints</a>
                    <a href="/dashboard" class="text-xs uppercase tracking-widest border border-[#00f0ff]/40 px-3 py-2 rounded hover:bg-[#00f0ff]/10">Mi cuenta</a>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="cyber-border p-5 rounded">
                <p class="text-xs opacity-40 uppercase">Server Uptime</p>
                <h2 class="text-2xl sm:text-3xl font-bold mt-1"><%= uptime %></h2>
            </div>
            <div class="cyber-border p-5 rounded">
                <p class="text-xs opacity-40 uppercase">Latency Average</p>
                <h2 class="text-2xl sm:text-3xl font-bold mt-1"><%= avgLatency %>ms</h2>
            </div>
            <div class="cyber-border p-5 rounded">
                <p class="text-xs opacity-40 uppercase">Active Scrapers</p>
                <h2 class="text-2xl sm:text-3xl font-bold mt-1"><%= activeScrapers %></h2>
            </div>
        </div>

        <div class="cyber-border rounded-lg overflow-hidden mb-8">
            <div class="p-4 bg-[#00f0ff]/5 border-b border-[#00f0ff]/20">
                <h3 class="text-sm font-bold tracking-widest uppercase">API_KEY_CONTROL_PANEL</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="opacity-40 border-b border-white/5 text-xs">
                            <th class="p-4">IDENTIFIER</th>
                            <th>PLAN</th>
                            <th>USAGE_METRICS</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% Object.keys(keys).forEach(k => { %>
                        <% const acc = keys[k]; const limitReached = acc.used >= acc.limit; %>
                        <tr class="border-b border-white/5 hover:bg-[#00f0ff]/5 transition-all">
                            <td class="p-4 text-white whitespace-nowrap"><%= k %></td>
                            <td><span class="bg-[#00f0ff]/10 text-[#00f0ff] px-2 py-1 rounded text-xs"><%= acc.plan %></span></td>
                            <td class="whitespace-nowrap"><%= acc.used %> / <%= acc.limit %></td>
                            <td class="<%= limitReached ? 'text-red-500' : 'text-green-500' %> italic font-bold">
                                <%= limitReached ? 'LIMIT_REACHED' : 'READY' %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div class="text-[11px] opacity-30 uppercase tracking-widest">© 2024 ALEX INFRASTRUCTURE</div>
            <div class="text-[11px] sm:text-right opacity-30 uppercase tracking-widest italic">Encrypted Secure Tunnel Enabled</div>
        </div>
    </div>
</body>
</html>
