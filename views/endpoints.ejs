<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX SCRAPER | ENDPOINTS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0c0e0e; color: #00f0ff; font-family: 'Geist Mono', monospace; }
        .cyber-border { border: 1px solid rgba(0, 240, 255, 0.3); background: #111313; }
        input { background: #0c0e0e; border: 1px solid rgba(0,240,255,0.3); color: #fff; }
        input:focus { outline: none; border-color: #00f0ff; }
        pre { white-space: pre-wrap; word-break: break-all; }
        .nav-link { font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; opacity: 0.6; }
        .nav-link:hover { opacity: 1; }
    </style>
</head>
<body class="p-4 sm:p-6 md:p-10">
    <div class="max-w-3xl mx-auto">
        <header class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-[#00f0ff]/40 pb-6 mb-6">
            <h1 class="text-lg sm:text-xl font-black italic">ALEX_SCRAPER_API</h1>
            <nav class="flex gap-4 flex-wrap">
                <a href="/" class="nav-link">Inicio</a>
                <a href="/endpoints" class="nav-link text-[#00f0ff] opacity-100">Endpoints</a>
                <a href="/dashboard" class="nav-link">Cuenta</a>
                <a href="/logout" class="nav-link text-red-400">Salir</a>
            </nav>
        </header>

        <p class="text-xs opacity-40 uppercase tracking-widest mb-1">Tu API Key</p>
        <p class="text-sm font-bold text-white mb-6 break-all"><%= apiKey %></p>

        <div class="space-y-5">
        <% endpoints.forEach(ep => { %>
            <div class="cyber-border rounded-lg p-4 sm:p-5">
                <h2 class="text-sm font-bold uppercase tracking-widest mb-1"><%= ep.name %></h2>
                <p class="text-xs opacity-50 mb-3"><%= ep.desc %></p>

                <div class="bg-black/40 rounded p-2 text-[11px] mb-3 break-all">
                    <span class="text-green-400 font-bold">GET</span>
                    <%= ep.path %>?<%= ep.param %>=TU_VALOR&apikey=<%= apiKey %>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 mb-3">
                    <input id="input-<%= ep.id %>" type="text" placeholder="<%= ep.placeholder %>" class="flex-1 p-3 rounded text-sm">
                    <button onclick="probar('<%= ep.id %>', '<%= ep.path %>', '<%= ep.param %>')"
                        class="bg-[#00f0ff]/10 border border-[#00f0ff]/50 text-[#00f0ff] px-4 py-3 rounded text-xs font-bold uppercase hover:bg-[#00f0ff]/20 transition-all whitespace-nowrap">
                        Probar
                    </button>
                </div>

                <div class="flex justify-between items-center mb-2 flex-wrap gap-2">
                    <p class="text-xs opacity-40 uppercase">Resultado</p>
                    <div class="flex gap-3">
                        <button onclick="copiarEndpoint('<%= ep.id %>', '<%= ep.path %>', '<%= ep.param %>', this)" class="text-[11px] underline opacity-60 hover:opacity-100">Copiar Endpoint</button>
                        <button onclick="copiarResultado('<%= ep.id %>', this)" class="text-[11px] underline opacity-60 hover:opacity-100">Copiar JSON</button>
                    </div>
                </div>
                <pre id="result-<%= ep.id %>" class="bg-black/40 rounded p-3 text-[11px] text-white/70 min-h-[3rem]">Aquí aparecerá el resultado...</pre>
                <div id="media-<%= ep.id %>" class="mt-1"></div>
            </div>
        <% }) %>
        </div>
    </div>


    <script>
        const API_KEY = <%- JSON.stringify(apiKey) %>;

        async function probar(id, path, param) {
            const input = document.getElementById('input-' + id).value.trim();
            const box = document.getElementById('result-' + id);
            const mediaBox = document.getElementById('media-' + id);
            mediaBox.innerHTML = '';
            box.textContent = 'Cargando...';
            const url = input
                ? path + '?' + param + '=' + encodeURIComponent(input) + '&apikey=' + encodeURIComponent(API_KEY)
                : path + '?apikey=' + encodeURIComponent(API_KEY);
            try {
                const res = await fetch(url);
                const data = await res.json();
                box.textContent = JSON.stringify(data, null, 2);
                mostrarMedia(mediaBox, data);
            } catch (e) {
                box.textContent = 'Error: ' + e.message;
            }
        }

        function buscarMedia(obj, profundidad) {
            if (!obj || typeof obj !== 'object' || profundidad > 3) return null;
            const mapa = [
                ['gif_url', 'gif'], ['video_url', 'video'], ['audio_url', 'audio'],
                ['imagen_url', 'imagen'], ['imagen_qr', 'imagen'], ['media_url', 'imagen'],
                ['miniatura', 'imagen'], ['thumbnail', 'imagen'], ['avatar', 'imagen']
            ];
            for (const [campo, tipo] of mapa) {
                if (typeof obj[campo] === 'string' && obj[campo]) return { tipo, url: obj[campo] };
            }
            if (Array.isArray(obj.result) && obj.result.length) return buscarMedia(obj.result[0], profundidad + 1);
            if (obj.result && typeof obj.result === 'object') return buscarMedia(obj.result, profundidad + 1);
            return null;
        }

        function mostrarMedia(cont, data) {
            const media = buscarMedia(data, 0);
            if (!media) return;

            let elemento;
            if (media.tipo === 'video') {
                elemento = document.createElement('video');
                elemento.src = media.url; elemento.controls = true;
            } else if (media.tipo === 'audio') {
                elemento = document.createElement('audio');
                elemento.src = media.url; elemento.controls = true;
            } else {
                elemento = document.createElement('img');
                elemento.src = media.url;
            }
            elemento.className = 'w-full rounded mt-2 max-h-72 object-contain bg-black/30';
            cont.appendChild(elemento);

            const etiquetas = { gif: 'Descargar GIF', video: 'Descargar Video', audio: 'Descargar Audio', imagen: 'Descargar Imagen' };
            const link = document.createElement('a');
            link.href = media.url;
            link.target = '_blank';
            link.rel = 'noopener';
            link.download = '';
            link.textContent = etiquetas[media.tipo] || 'Descargar';
            link.className = 'inline-block mt-2 text-[11px] bg-[#00f0ff]/10 border border-[#00f0ff]/50 text-[#00f0ff] px-3 py-2 rounded uppercase tracking-widest hover:bg-[#00f0ff]/20';
            cont.appendChild(link);
        }

        function copiarTexto(texto, boton) {
            const textoOriginal = boton ? boton.textContent : null;
            const marcarExito = () => {
                if (boton) { boton.textContent = '¡Copiado!'; setTimeout(() => { boton.textContent = textoOriginal; }, 1500); }
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(texto).then(marcarExito).catch(() => copiarConRespaldo(texto, marcarExito));
            } else {
                copiarConRespaldo(texto, marcarExito);
            }
        }

        function copiarConRespaldo(texto, alExito) {
            try {
                const temp = document.createElement('textarea');
                temp.value = texto;
                temp.style.position = 'fixed';
                temp.style.opacity = '0';
                document.body.appendChild(temp);
                temp.focus();
                temp.select();
                const ok = document.execCommand('copy');
                document.body.removeChild(temp);
                if (ok) { alExito(); } else { alert('No se pudo copiar automáticamente. Selecciona y copia el texto manualmente.'); }
            } catch (e) {
                alert('No se pudo copiar automáticamente. Selecciona y copia el texto manualmente.');
            }
        }

        function copiarEndpoint(id, path, param, boton) {
            const input = document.getElementById('input-' + id).value.trim() || 'TU_VALOR';
            const text = path + '?' + param + '=' + encodeURIComponent(input) + '&apikey=' + API_KEY;
            copiarTexto(text, boton);
        }

        function copiarResultado(id, boton) {
            const box = document.getElementById('result-' + id);
            copiarTexto(box.textContent, boton);
        }
    </script>
</body>
</html>
